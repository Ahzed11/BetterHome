{
  "realm": "betterhome",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "admin", "description": "Household administrator" },
      { "name": "member", "description": "Household member" },
      { "name": "service", "description": "Backend service account for internal endpoints" }
    ]
  },
  "clients": [
    {
      "clientId": "betterhome-api",
      "name": "BetterHome API",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "secret": "local-dev-only-change-me"
    },
    {
      "clientId": "betterhome-app",
      "name": "BetterHome Flutter App",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "com.betterhome.betterhome:/oauth2redirect",
        "http://localhost:8090/redirect.html"
      ],
      "webOrigins": ["http://localhost:8090"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "com.betterhome.betterhome:/oauth2redirect##http://localhost:8090/redirect.html"
      }
    },
    {
      "clientId": "betterhome-tasks-service",
      "name": "BetterHome tasks service",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "secret": "local-dev-only-change-me"
    },
    {
      "clientId": "betterhome-scoring-service",
      "name": "BetterHome scoring service",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "secret": "local-dev-only-change-me"
    },
    {
      "clientId": "betterhome-lists-service",
      "name": "BetterHome lists service",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "secret": "local-dev-only-change-me"
    },
    {
      "clientId": "betterhome-notifications-service",
      "name": "BetterHome notifications service",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "secret": "local-dev-only-change-me"
    }
  ],
  "users": [
    {
      "username": "service-account-betterhome-tasks-service",
      "enabled": true,
      "serviceAccountClientId": "betterhome-tasks-service",
      "realmRoles": ["service"]
    },
    {
      "username": "service-account-betterhome-scoring-service",
      "enabled": true,
      "serviceAccountClientId": "betterhome-scoring-service",
      "realmRoles": ["service"]
    },
    {
      "username": "service-account-betterhome-lists-service",
      "enabled": true,
      "serviceAccountClientId": "betterhome-lists-service",
      "realmRoles": ["service"]
    },
    {
      "username": "service-account-betterhome-notifications-service",
      "enabled": true,
      "serviceAccountClientId": "betterhome-notifications-service",
      "realmRoles": ["service"]
    }
  ]
}
