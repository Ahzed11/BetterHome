# Red Hat hardened image (minimal, no shell, no package manager, non-root); see ADR 0025.
# Build the jars first (../../../../mvnw -f ../.. package), then from the service directory:
#   podman build -f src/main/docker/Dockerfile.jvm -t betterhome-households-service .
FROM registry.access.redhat.com/hi/openjdk:21.0-runtime

WORKDIR /deployments
COPY --chown=65532:65532 target/quarkus-app/lib/ lib/
COPY --chown=65532:65532 target/quarkus-app/*.jar ./
COPY --chown=65532:65532 target/quarkus-app/app/ app/
COPY --chown=65532:65532 target/quarkus-app/quarkus/ quarkus/

USER 65532
ENTRYPOINT ["java", "-Dquarkus.http.host=0.0.0.0", "-Djava.util.logging.manager=org.jboss.logmanager.LogManager", "-jar", "/deployments/quarkus-run.jar"]
